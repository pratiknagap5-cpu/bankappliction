# ==============================================================================
# Banking Financial Transaction Management System - Environment Variables
# ==============================================================================
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS.
# NEVER COMMIT YOUR REAL .env FILE OR PASSWORDS TO VERSION CONTROL.
# ==============================================================================

# ----- Gmail SMTP Configuration -----
# 1. Enable 2-Step Verification in your Google Account:
#    https://myaccount.google.com/security
# 2. Generate an App Password (select 'Mail' and 'Other (Banking App)'):
#    https://myaccount.google.com/apppasswords
# 3. Paste your full Gmail address and the 16-character App Password (without spaces) below.
GMAIL_USERNAME=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Optional SMTP Host & Port overrides (Defaults are smtp.gmail.com:587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ----- MySQL Database Configuration -----
DB_URL=jdbc:mysql://localhost:3306/banking_db
DB_USERNAME=root
DB_PASSWORD=pratik

# ----- Server Configuration -----
SERVER_PORT=8080

# ==============================================================================
# How to set environment variables in Windows:
# PowerShell:
#   $env:GMAIL_USERNAME="your-email@gmail.com"
#   $env:GMAIL_APP_PASSWORD="your-16-char-app-password"
#   .\mvnw.cmd spring-boot:run
#
# Command Prompt (cmd):
#   set GMAIL_USERNAME=your-email@gmail.com
#   set GMAIL_APP_PASSWORD=your-16-char-app-password
#   mvnw.cmd spring-boot:run
# ==============================================================================
